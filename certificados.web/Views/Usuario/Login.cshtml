@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CERTIFICADOS</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/login.css">

</head>
<body>
    <main class="container-fluid min-vh-100 d-flex justify-content-center align-items-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-5">
                    <div class="card shadow-lg">
                        <div class="card-body">
                            <div class="text-center mb-5">
                                <img src="/img/logoug.png" alt="Logo Universidad" width="220" height="150" />
                            </div>
                            <h3 class="text-center mb-3 custom-heading">VICERRECTORADO ACADÉMICO</h3>
                            <h4 class="text-center mb-4 custom-heading">CERTIFICADOS</h4>
                            <form id="loginForm" novalidate>
                                <div class="mb-4">
                                    <label for="email" class="form-label">Correo Institucional</label>
                                    <input type="email" class="form-control form-control-lg" id="email" placeholder="ejemplo@ug.edu.ec" required autocomplete="email" aria-describedby="emailHelp">
                                    <div class="invalid-feedback">Por favor, introduce una dirección de correo electrónico válida.</div>
                                </div>
                                <div class="mb-4">
                                    <label for="password" class="form-label">Contraseña</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control form-control-lg" id="password" required autocomplete="current-password" aria-describedby="passwordHelp">
                                        <button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="Mostrar contraseña">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback">La contraseña debe tener al menos 8 caracteres.</div>
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg w-100" id="loginBtn">
                                    <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                                    Iniciar Sesión
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/login.js"></script>
</body>
</html>
