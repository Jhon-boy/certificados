@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="~/css/dashboard.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 header d-flex justify-content-between align-items-center">
                <div>
                    <img src="~/img/logo_ug_vertical.svg" alt="Logo" class="logo">
                </div>
                <div class="text-center">
                    <h4>VICERRECTORADO ACADÉMICO</h4>
                    <h5>Sistema de Certificación</h5>
                </div>
                <div class="user-menu">
                    <button class="btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=40" alt="Usuario" class="rounded-circle me-2">
                        <span class="d-none d-md-inline">Ruth</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="#">Perfil</a></li>
                        <li><a class="dropdown-item" href="#">Configuración</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">Cerrar sesión</a></li>
                    </ul>
                </div>
            </div>

            <div class="col-3 col-md-2 p-0 sidebar bg-dark">
                <ul class="nav flex-column text-white">
                    <li class="nav-item">
                        <a class="nav-link text-white" onclick="toggleCollapse('submenu1')">
                            <i class="bi bi-wrench"></i> Mantenimiento <i class="bi bi-caret-down-fill arrow"></i>
                        </a>
                        <div class="submenu" id="submenu1" style="display: none;">
                            <ul class="nav flex-column ms-3">
                                <li class="nav-item"><a class="nav-link text-white" href="#" id="link-grupo" data-view="Grupo"><i class="bi bi-people"></i> Grupo</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#" id="link-decanato" data-view="Decanato"><i class="bi bi-building"></i> Decanatos</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#" id="link-modalidad" data-view="Modalidad"><i class="bi bi-calendar"></i> Modalidad</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#" id="link-tipoevento" data-view="TipoEvento"><i class="bi bi-file-earmark-text"></i> Tipo de Evento</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#" id="link-ciclo" data-view="Ciclo"><i class="bi bi-hourglass"></i> Ciclo</a></li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item"><a class="nav-link text-white" href="#" id="link-planificacion" data-view="Planificacion"><i class="bi bi-calendar-check"></i> Planificación</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-person-plus"></i> Registro Participante / Facilitador</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-clipboard-check"></i> Registro Calificaciones / Asistencias</a></li>
                    <li class="nav-item">
                        <a class="nav-link text-white" onclick="toggleCollapse('submenu2')">
                            <i class="bi bi-clipboard-check"></i> Certificación <i class="bi bi-caret-down-fill arrow"></i>
                        </a>
                        <div class="submenu" id="submenu2" style="display: none;">
                            <ul class="nav flex-column ms-3">
                                <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-file-earmark-text"></i> Generar Plantilla</a></li>
                                <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-file-earmark-pdf"></i> Generar Certificado</a></li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-search"></i> Consultas Certificados / Eventos</a></li>
                </ul>
            </div>

            <div class="col-9 col-md-10 dynamic-content p-4" id="dynamic-content">

            </div>
        </div>
    </div>

</body>
</html>
