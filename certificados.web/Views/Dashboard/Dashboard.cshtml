@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="~/css/Dashboard.css">
</head>
<body>

    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="logo-container text-center">
            <img src="~/img/logughorizontal.png" alt="Logo UG" class="logo">
        </div>

        <ul class="nav flex-column mt-4">
            <li class="nav-item"><a class="nav-link text-white" href="#" id="link-roles" data-view="Inicio"><i class="bi  bi-house"></i> Home</a></li>

            <li class="nav-item mt-3">
                <a class="nav-link text-white" onclick="toggleCollapse('submenu1')">
                    <i class="bi bi-wrench"></i> Mantenimiento <i class="bi bi-caret-down-fill arrow"></i>
                </a>
                <div class="submenu" id="submenu1" style="display: none;">
                    <ul class="nav flex-column ms-3">
                        <li onclick="cargarDatosRoles()" class="nav-item"><a class="nav-link text-white" href="#" id="link-roles" data-view="Roles"><i class="bi bi-shield-lock"></i> Roles</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-personas" data-view="Personas"><i class="bi bi-people"></i> Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-grupo" data-view="Grupo"><i class="bi bi-person-lines-fill"></i> Grupo</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-docente" data-view="Docente"><i class="bi bi-person-video3"></i> Docentes</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-decanato" data-view="Decanato"><i class="bi  bi-layers-fill"></i> Decanatos</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-evento" data-view="Eventos"><i class="bi bi-play-btn"></i> Eventos</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-certificados" data-view="Certificados"><i class="bi bi-clipboard-check"></i> Certificados</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-actas" data-view="Actas"><i class="bi bi-receipt"></i> Actas</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link  text-white" onclick="toggleCollapse('submenu3')">
                    <i class="bi bi-calendar-check"></i> Planificación <i class="bi bi-caret-down-fill arrow"></i>
                </a>
                <div class="submenu" id="submenu3" style="display: none;">
                    <ul class="nav flex-column ms-3">
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-addplanificacion" data-view="RegistrarPlanificacion"><i class="bi bi-clipboard-check"></i> Registrar Planificación </a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-manatenimientoplanificacion" data-view="MantenimientoPlanificacion"><i class="bi bi-receipt"></i> Mantenimiento </a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link  text-white" onclick="toggleCollapse('submenu4')">
                    <i class="bi bi-person-plus"></i> Participante <i class="bi bi-caret-down-fill arrow"></i>
                </a>
                <div class="submenu" id="submenu4" style="display: none;">
                    <ul class="nav flex-column ms-3">
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-registrarparticipante" data-view="RegistrarParticipante"><i class="bi bi-clipboard-check"></i> Registrar Participante </a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-manatenimientoparticipante" data-view="MantenimientoParticipante"><i class="bi bi-receipt"></i> Mantenimiento </a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link  text-white" onclick="toggleCollapse('submenu5')">
                    <i class="bi bi-person-plus"></i> Facilitador <i class="bi bi-caret-down-fill arrow"></i>
                </a>
                <div class="submenu" id="submenu5" style="display: none;">
                    <ul class="nav flex-column ms-3">
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-registrarfacilitador" data-view="RegistrarFacilitador"><i class="bi bi-clipboard-check"></i> Registrar Facilitador </a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#" id="link-manatenimientoparticipante" data-view="MantenimientoFacilitador"><i class="bi bi-receipt"></i> Mantenimiento </a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link  text-white" href="#">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Registro Calificaciones</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" onclick="toggleCollapse('submenu2')">
                    <i class="bi bi-clipboard-check"></i> Certificación <i class="bi bi-caret-down-fill arrow"></i>
                </a>
                <div class="submenu" id="submenu2" style="display: none;">
                    <ul class="nav flex-column ms-3">
                        <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-file-earmark-text"></i> Generar Plantilla</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="#"><i class="bi bi-file-earmark-pdf"></i> Generar Certificado</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link  text-white" href="#">
                    <i class="bi bi-search"></i>
                    <span>Consultas</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Header -->
    <header class="main-header">
        <div class="container-fluid h-100">
            <div class="row h-100 align-items-center">
                <div class="col">
                    <h4 class="mb-0">Dashboard de Administración</h4>
                    <small class="text-muted">Sistema de Certificación</small>
                </div>
                <div class="col-auto">
                    <div class="user-menu dropdown">
                        <button class="btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=40" alt="Usuario" class="me-2">
                            <span id="userLog" class="me-2"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Perfil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Configuración</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#logOutModal"><a class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Modal logOut -->
    <div class="modal fade" id="logOutModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Aviso</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <center>
                        ¿Estas seguro de cerrar sesión?
                    </center>
                  
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="logOut()">Cerrar Sesión</button>
                </div>
            </div>
        </div>
    </div>


    <!-- Main Content (Workspace) -->
    <main class="main-content fade-in">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-9 col-11 dynamic-content p-4" id="dynamic-content">
                    <!-- Your dynamic content goes here -->
                </div>  
            </div>
        </div>
    </main>
    <script src="~/js/Utils.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script src="~/js/roles.js"></script>
</body>
</html>
