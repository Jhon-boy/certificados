@{
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Layout</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Header Section -->
            <div class="col-12 header d-flex justify-content-between align-items-center">
                <div>
                    <img src="~/img/logo_ug_vertical.svg" alt="Logo" class="logo" style="max-width: 150px;">
                </div>
                <div class="title text-center">
                    <h4>VICERRECTORADO ACADÉMICO</h4>
                    <h5>Sistema de Certificación</h5>
                </div>
                <div class="user-menu">
                    <button class="btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=40"
                             alt="Usuario"
                             class="rounded-circle me-2">
                        <span class="d-none d-md-inline">Ruth</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="#">Perfil</a></li>
                        <li><a class="dropdown-item" href="#">Configuración</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">Cerrar sesión</a></li>
                    </ul>
                </div>
            </div>

            <!-- Sidebar Menu -->
            <div class="col-3 menu">
                <nav class="nav flex-column">
                    <a class="nav-link" href="#"><i class="fas fa-cogs"></i> Mantenimiento</a>
                    <a class="nav-link" href="#"><i class="fas fa-calendar-alt"></i> Planificación</a>
                    <a class="nav-link" href="#"><i class="fas fa-edit"></i> Registro</a>
                    <a class="nav-link" href="#"><i class="fas fa-check-circle"></i> Aprobación Participantes</a>
                    <a class="nav-link" href="#"><i class="fas fa-certificate"></i> Certificación</a>
                    <a class="nav-link" href="#"><i class="fas fa-search"></i> Consultas</a>
                </nav>
            </div>

            <!-- Dynamic Content -->
            <div class="col-9 dynamic-content">
                <h2>Espacio de Trabajo Dinámico</h2>
                <p>Aquí se cargará el contenido según la selección del menú.</p>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
