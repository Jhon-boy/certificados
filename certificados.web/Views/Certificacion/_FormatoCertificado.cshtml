<div class="container mt-4">
    <!-- Tabs para la vista de Formatos -->
    <ul class="nav nav-tabs" id="formatosTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link text-dark active" id="tabla-formatos-tab" data-bs-toggle="tab" href="#tabla-formatos" role="tab" aria-controls="tabla-formatos" aria-selected="true">Listar Formatos</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link text-dark" id="formulario-formatos-tab" data-bs-toggle="tab" href="#formulario-formatos" role="tab" aria-controls="formulario-formatos" aria-selected="false">Agregar Formato</a>
        </li>
    </ul>

    <div class="tab-content" id="formatosTabContent">
        <br />
        <!-- Contenido de la pestaña de la tabla -->
        <div class="tab-pane fade show active m-1" id="tabla-formatos" role="tabpanel" aria-labelledby="tabla-formatos-tab">
            <table id="tabla-formato" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Id Formato</th>
                        <th>Logo Universidad</th>
                        <th>Logo Secundario</th>
                        <th>Marca de Agua</th>
                        <th>QR</th>
                        <th>Usuario Ingreso</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Aquí se mostrarán los datos de los formatos -->
                </tbody>
            </table>
        </div>

        <!-- Contenido de la pestaña del formulario -->
        <div class="tab-pane fade" id="formulario-formatos" role="tabpanel" aria-labelledby="formulario-formatos-tab">
            <!-- Formulario de Agregar Formato -->
            <form id="form-formato" class="border border-2 p-4 rounded" onsubmit="handleAgregarFormato(event)">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="logo-universidad" class="form-label">Logo Universidad</label>
                        <input type="file" accept="image/png" class="form-control" id="logo-universidad" name="logo-universidad" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="logo-secundario" class="form-label">Logo Secundario</label>
                        <input type="file" accept="image/png" class="form-control" id="logo-secundario" name="logo-secundario" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="marca-agua" class="form-label">Marca de Agua</label>
                        <input type="file" accept="image/png" class="form-control" id="marca-agua" name="marca-agua" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="qr" class="form-label">QR</label>
                        <input type="file" accept="image/png" class="form-control" id="qr" name="qr" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="usuario-ingreso-formato" class="form-label">Usuario Ingreso</label>
                        <input type="text" class="form-control" id="usuario-ingreso-formato" name="usuario-ingreso-formato" disabled value="">
                    </div>
                </div>
                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary mx-2">Guardar</button>
                    <button type="reset" class="btn btn-secondary mx-2">Limpiar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal de edición -->
<div class="modal fade" id="modal-editar-formato" tabindex="-1" aria-labelledby="modal-editar-formato-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-editar-formato-label">Editar Formato</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Formulario de Edición de Formato -->
                <form id="form-editar-formato" class="border border-2 p-4 rounded" onsubmit="handleEditarFormato(event)">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editar-logo-universidad" class="form-label">Logo Universidad</label>
                            <input type="file" accept="image/png" class="form-control" id="editar-logo-universidad" name="editar-logo-universidad">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editar-logo-secundario" class="form-label">Logo Secundario</label>
                            <input type="file" accept="image/png" class="form-control" id="editar-logo-secundario" name="editar-logo-secundario">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editar-marca-agua" class="form-label">Marca de Agua</label>
                            <input type="file" accept="image/png" class="form-control" id="editar-marca-agua" name="editar-marca-agua">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editar-qr" class="form-label">QR</label>
                            <input type="file" accept="image/png" class="form-control" id="editar-qr" name="editar-qr">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editar-usuario-ingreso" class="form-label">Usuario Ingreso</label>
                            <input type="text" class="form-control" id="editar-usuario-ingreso" name="editar-usuario-ingreso" disabled value="admin">
                        </div>
                        <div class="col-md-6 mb-3">
                            <input type="hidden" id="formato-id-editar" name="formato-id-editar">
                        </div>
                    </div>
                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn btn-primary mx-2">Guardar Cambios</button>
                        <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
