<div class="container mt-1">
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link text-dark active" id="generar-certificado" data-bs-toggle="tab" href="#generar" role="tab" aria-controls="generar" aria-selected="true">Participantes Aprobados</a>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent">
        <br />
        <div class="tab-pane fade show active" id="generar" role="tabpanel" aria-labelledby="generar-certificado">
            <div class="card my-5 mx-2">
                <div class="card-header">
                    <h5>Configuración del Certificado</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-5">
                                <div class="form-group">
                                    <label for="beneficiario" class="form-label">Beneficiario</label>
                                    <select class="form-select" id="beneficiario">
                                        <option value="participantes" selected>Participantes</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-5">
                                <div class="form-group">
                                    <label for="grupo" class="form-label">Grupo</label>
                                    <select class="form-select" id="persona-id-grupo-generar" name="persona-id-grupo-generar" required oninput="this.setCustomValidity('')"
                                            oninvalid="this.setCustomValidity('Por favor, complete este campo.')">
                                        <option value="">Selecciona un grupo</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-5">
                                <div class="form-group">
                                    <label for="condicion" class="form-label">Condición</label>
                                    <select class="form-select" id="condicion">
                                        <option value="1" selected>Ambos</option>
                                        <option value="2">Calificación</option>
                                        <option value="3">Asistencia</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mx-2 my-5">
                <div class="card-header">
                    <h5>Lista de Participantes</h5>
                </div>
                <div class="container my-1">
                    <div class="row">
                        <div class="col">
                            <table id="tabla-generar-certificado" class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Cédula</th>
                                        <th>Nombres</th>
                                        <th>Asistencia</th>
                                        <th>Calificaciones</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Aquí se cargarán los registros de certificados -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-auto">
                    <button onclick="generarAprobados()" class="btn btn-primary me-2">Generar</button>
                    <button class="btn btn-secondary">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>
