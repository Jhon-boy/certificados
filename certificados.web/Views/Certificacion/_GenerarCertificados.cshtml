<div class="container mt-4">
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="home-tab" data-bs-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Participantes Aprobados</a>
        </li>
    </ul>
    <br />
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
            <form id="formParticipante" class="border border-2 p-4 rounded mt-3">
                <div class="row">
                    <!-- Beneficiario Select -->
                    <div class="col-12 col-md-4 mb-3">
                        <label for="beneficiario" class="form-label">Beneficiario</label>
                        <select id="beneficiario" class="form-select">
                            <option value="participantes" selected>Participantes</option>
                        </select>
                    </div>

                    <!-- Grupo Select -->
                    <div class="col-12 col-md-4 mb-3">
                        <label for="grupo" class="form-label">Grupo</label>
                        <select id="grupo" class="form-select">
                            <option selected>Selecciona Grupo</option>
                            <!-- Opciones dinámicas se agregarán aquí -->
                        </select>
                    </div>

                    <!-- Condición Select -->
                    <div class="col-12 col-md-4 mb-3">
                        <label for="formato" class="form-label">Formato</label>
                        <select id="formato" class="form-select">
                            <option selected>Selecciona Formato</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label for="decanato" class="form-label">Decanato</label>
                        <select id="decanato" class="form-select">
                            <option selected>Seleccionar Decanato</option>
                        </select>
                    </div>
                </div>
            </form>
            <br />
            <br />
            <table class="table mt-4" id="tablaParticipantes">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombres</th>
                        <th>Asistencia</th>
                        <th>Calificaciones</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
