@section Scripts {
    <script src="~/js/Config.js"></script>
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active text-dark" id="home-tab" data-bs-toggle="tab" data-bs-target="#nav-home" type="button" role="tab" aria-controls="nav-home" aria-selected="true">Mi usuario</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link text-dark" id="profile-tab" data-bs-toggle="tab" data-bs-target="#nav-profile" type="button" role="tab" aria-controls="nav-profile" aria-selected="false">Persona</button>
    </li>
</ul>

<div class="tab-content" id="nav-tabContent">
    <!-- Tab Usuario -->
    <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="home-tab">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h5 class="mb-4 fw-bold">Información de Usuario</h5>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label text-muted">Email</label>
                    <input type="text" class="form-control bg-light" id="email" disabled>
                </div>

                <!-- Roles -->
                <div class="mb-3">
                    <label class="form-label text-muted">Roles</label>
                    <input type="text" class="form-control bg-light" id="roles" disabled>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label class="form-label text-muted">Contraseña</label>
                    <input type="password" class="form-control bg-light" id="password" disabled>
                </div>

                <!-- Botones -->
                <div class="text-end">
                    <button class="btn btn-primary" onclick="habilitarEdicionUsuario()">Habilitar Edición</button>
                    <button class="btn btn-success" id="btnSave" onclick="guardarCambiosUsuario()" disabled>Guardar Cambios</button>
                    <button class="btn btn-secondary" id="btnCancel" onclick="cancelarEdicionUsuario()" disabled>Cancelar Cambios</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Persona -->
    <div class="tab-pane fade" id="nav-profile" role="tabpanel" aria-labelledby="profile-tab">
        <h5 class="mb-4 fw-bold">Información Personal</h5>
        <div class="row row-cols-md-2 g-3">
            <!-- Nombres -->
            <div class="col">
                <label class="form-label text-muted">Nombres</label>
                <input type="text" class="form-control bg-light" id="nombres" disabled>
            </div>

            <!-- Apellidos -->
            <div class="col">
                <label class="form-label text-muted">Apellidos</label>
                <input type="text" class="form-control bg-light" id="apellidos" disabled>
            </div>

            <!-- Cédula -->
            <div class="col">
                <label class="form-label text-muted">Cédula</label>
                <input type="text" class="form-control bg-light" id="cedula" disabled>
            </div>

            <!-- Edad -->
            <div class="col">
                <label class="form-label text-muted">Edad</label>
                <input type="text" class="form-control bg-light" id="edad" disabled>
            </div>

            <!-- Género -->
            <div class="col">
                <label class="form-label text-muted">Género</label>
                <input type="text" class="form-control bg-light" id="genero" disabled>
            </div>

            <!-- Usuario Ingreso -->
            <div class="col">
                <label class="form-label text-muted">Usuario Ingreso</label>
                <input type="text" class="form-control bg-light" id="usuarioIngreso" disabled>
            </div>

            <!-- Usuario Actualización -->
            <div class="col">
                <label class="form-label text-muted">Usuario Actualización</label>
                <input type="text" class="form-control bg-light" id="usuarioActualizacion" disabled>
            </div>

            <!-- Fecha Creación -->
            <div class="col">
                <label class="form-label text-muted">Fecha Creación</label>
                <input type="text" class="form-control bg-light" id="fechaCreacion" disabled>
            </div>

            <!-- Última Modificación -->
            <div class="col">
                <label class="form-label text-muted">Última Modificación</label>
                <input type="text" class="form-control bg-light" id="fechaModificacion" disabled>
            </div>
        </div>

        <!-- Botones -->
        <div class="text-end mt-3">
            <button class="btn btn-primary" onclick="habilitarEdicionPersona()">Habilitar Edición</button>
            <button class="btn btn-success" id="btnSavePersona" onclick="guardarCambiosPersona()" disabled>Guardar Cambios</button>
            <button class="btn btn-secondary" id="btnCancelPersona" onclick="cancelarEdicionPersona()" disabled>Cancelar Cambios</button>
        </div>
    </div>
</div>

<script src="~/js/Config.js" asp-append-version="true"></script>
