@{
    ViewData["Title"] = "Home";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin - Material Design</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/Home.css" rel="stylesheet" />
</head>
<body>
    <div class="welcome-section">
        <!-- Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="material-card p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">Dashboard</h4>
                            <p class="text-muted mb-0">Bienvenido de nuevo, <strong>Administrador</strong></p>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-success badge-custom me-2">
                                <i class="fas fa-circle me-1"></i> Online
                            </span>
                            <span class="text-muted">Último acceso: Hoy 09:30 AM</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-sm-6">
                <div class="material-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
                                <i class="fas fa-users"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Personas Registradas</h6>
                                <h3 class="mb-0">40</h3>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress">
                                <div class="progress-bar bg-primary" style="width: 75%"></div>
                            </div>
                            <small class="text-success mt-2 d-block">
                                <i class="fas fa-arrow-up"></i> +12% este mes
                            </small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="material-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Eventos</h6>
                                <h3 class="mb-0">5</h3>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress">
                                <div class="progress-bar bg-warning" style="width: 45%"></div>
                            </div>
                            <small class="text-warning mt-2 d-block">
                                <i class="fas fa-clock"></i> 2 eventos próximos
                            </small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="material-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
                                <i class="fas fa-chalkboard-teacher"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Docentes</h6>
                                <h3 class="mb-0">5</h3>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress">
                                <div class="progress-bar bg-success" style="width: 60%"></div>
                            </div>
                            <small class="text-success mt-2 d-block">
                                <i class="fas fa-check"></i> Todos activos
                            </small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="material-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-danger bg-opacity-10 text-danger me-3">
                                <i class="fas fa-certificate"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Certificados</h6>
                                <h3 class="mb-0">5</h3>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress">
                                <div class="progress-bar bg-danger" style="width: 30%"></div>
                            </div>
                            <small class="text-danger mt-2 d-block">
                                <i class="fas fa-clock"></i> 3 pendientes
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-xl-8 mb-4 mb-xl-0">
                <div class="material-card p-4">
                    <h5 class="card-title mb-4">Estadísticas Generales</h5>
                    <canvas id="mainChart" height="135"></canvas>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="material-card p-4">
                    <h5 class="card-title mb-4">Distribución</h5>
                    <canvas id="pieChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-8 mb-4 mb-xl-0">
                <div class="material-card p-4">
                    <h5 class="card-title mb-4">Actividad Reciente</h5>
                    <div class="activity-item">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="mb-1">Nuevo registro de usuario</h6>
                                <p class="text-muted mb-0">Juan Pérez se ha registrado en el sistema</p>
                            </div>
                            <small class="text-muted">Hace 5 minutos</small>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="mb-1">Evento creado</h6>
                                <p class="text-muted mb-0">Se ha creado el evento "Workshop de Desarrollo Web"</p>
                            </div>
                            <small class="text-muted">Hace 2 horas</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="material-card p-4">
                    <h5 class="card-title mb-4">Acciones Rápidas</h5>
                    <div class="d-grid gap-3">
                        <button class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i> Nuevo Usuario
                        </button>
                        <button class="btn btn-outline-primary">
                            <i class="fas fa-calendar-plus me-2"></i> Crear Evento
                        </button>
                        <button class="btn btn-outline-primary">
                            <i class="fas fa-file-alt me-2"></i> Generar Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
    <script src="~/js/Home.js"></script>
</body>
</html>