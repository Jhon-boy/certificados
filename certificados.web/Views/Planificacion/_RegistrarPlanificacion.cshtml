<div class="container mt-5">
    <div class="row mb-3">
        <div class="col">
            <strong>Decanato:</strong>
            <label for="decanato" class="col-form-label">Formación Académica y Prosefional</label>
        </div>
    </div>
    <form id="eventoForm" class="needs-validation px-3 py-3" novalidate onsubmit="return registrarEvento(event)">
        <div class="row">
            <!-- Fecha Inicio -->
            <div class="col-md-4 mb-3 position-relative">
                <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                <input type="datetime-local" id="fechaInicio" class="form-control" required>
                <div class="invalid-tooltip">Selecciona la fecha de inicio</div>
            </div>
            <!-- Fecha Fin -->
            <div class="col-md-4 mb-3 position-relative">
                <label for="fechaFin" class="form-label">Fecha Fin</label>
                <input type="datetime-local" id="fechaFin" class="form-control" required>
                <div class="invalid-tooltip">Selecciona la fecha de fin</div>
            </div>
            <!-- Horas -->
            <div class="col-md-4 mb-3 position-relative">
                <label for="horas" class="form-label">Horas</label>
                <input type="number" id="horas" class="form-control" min="1" placeholder="Ingrese las horas" required>
                <div class="invalid-tooltip">Escribe el número de horas</div>
            </div>
        </div>

        <div class="row">
            <!-- Lugar -->
            <div class="col-md-6 mb-3 position-relative">
                <label for="lugar" class="form-label">Lugar</label>
                <input type="text" id="lugar" class="form-control" maxlength="100" placeholder="Ingrese el lugar" required>
                <div class="invalid-tooltip">Escribe el lugar</div>
            </div>
            <!-- Con Certificado -->
            <div class="col-md-6 mb-3 position-relative">
                <label for="conCertificado" class="form-label">¿Con Certificado?</label>
                <select id="conCertificado" class="form-select" required>
                    <option value="1">Sí</option>
                    <option value="0">No</option>
                </select>
                <div class="invalid-tooltip">Selecciona si incluye certificado</div>
            </div>
        </div>

        <div class="row">
            <!-- Periodo -->
            <div class="col-md-4 mb-3 position-relative">
                <label for="periodo" class="form-label">Periodo</label>
                <input type="text" id="periodo" class="form-control" maxlength="20" placeholder="Ingrese el periodo" required>
                <div class="invalid-tooltip">Escribe el periodo</div>
            </div>
            <!-- Temática -->
            <div class="col-md-4 mb-3 position-relative">
                <label for="tematica" class="form-label">Temática</label>
                <input type="text" id="tematica" class="form-control" maxlength="50" placeholder="Ingrese la temática" required>
                <div class="invalid-tooltip">Escribe la temática</div>
            </div>
            <!-- Dominio -->
            <div class="col-md-4 mb-3 position-relative">
                <label for="dominio" class="form-label">Dominio</label>
                <input type="text" id="dominio" class="form-control" maxlength="50" placeholder="Ingrese el dominio" required>
                <div class="invalid-tooltip">Escribe el dominio</div>
            </div>
        </div>

        <div class="row">
            <!-- Id Grupo -->
            <div class="col-md-6 mb-3 position-relative">
                <label for="idGrupo" class="form-label">Grupo</label>
                <select id="idGrupo" class="form-select" required>
                    <option value="">Seleccione un grupo</option>
                    <!-- Opciones de ejemplo -->
                    <option value="1">Grupo A</option>
                    <option value="2">Grupo B</option>
                </select>
                <div class="invalid-tooltip">Selecciona un grupo</div>
            </div>
            <!-- Id Modalidad -->
            <div class="col-md-6 mb-3 position-relative">
                <label for="idModalidad" class="form-label">Modalidad</label>
                <select id="idModalidad" class="form-select" required>
                    <option value="">Seleccione una modalidad</option>
                    <!-- Opciones de ejemplo -->
                    <option value="1">Presencial</option>
                    <option value="2">Virtual</option>
                </select>
                <div class="invalid-tooltip">Selecciona una modalidad</div>
            </div>
        </div>

        <div class="row">
            <!-- Id Tipo Evento -->
            <div class="col-md-6 mb-3 position-relative">
                <label for="idTipoEvento" class="form-label">Tipo de Evento</label>
                <select id="idTipoEvento" class="form-select" required>
                    <option value="">Seleccione un tipo de evento</option>
                    <!-- Opciones de ejemplo -->
                    <option value="1">Conferencia</option>
                    <option value="2">Taller</option>
                </select>
                <div class="invalid-tooltip">Selecciona un tipo de evento</div>
            </div>
            <!-- Id Decanato -->
            <div class="col-md-6 mb-3 position-relative">
                <label for="idDecanato" class="form-label">Decanato</label>
                <select id="idDecanato" class="form-select" required>
                    <option value="">Seleccione un decanato</option>
                    <!-- Opciones de ejemplo -->
                    <option value="1">Decanato de Ciencias</option>
                    <option value="2">Decanato de Ingeniería</option>
                </select>
                <div class="invalid-tooltip">Selecciona un decanato</div>
            </div>
        </div>

        <!-- Botones -->
        <div class="col-12 d-flex mb-2 justify-content-center">
            <button type="submit" class="btn btn-primary me-3">Registrar</button>
            <button type="button" class="btn btn-danger" onclick="resetEventoForm()">Cancelar</button>
        </div>
    </form>
</div>