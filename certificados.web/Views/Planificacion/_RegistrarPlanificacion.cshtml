<div class="container mt-5">
    <div class="row mb-3">
        <div class="col">
            <strong>Decanato:</strong>
            <label for="decanato" class="col-form-label">Formación Académica y Prosefional</label>
        </div>
    </div>
    <form>
        <div class="border p-4">
            <div class="mb-3 row">
                <label for="tipoEvento" class="col-sm-2 col-form-label">Tipo de evento:</label>
                <div class="col-sm-10">
                    <select class="form-select" id="tipoEvento"></select>
                </div>
            </div>
            <div class="mb-3 row">
                <label for="curso" class="col-sm-2 col-form-label">Curso:</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" id="curso">
                </div>
            </div>
            <div class="mb-3 row">
                <label for="dominio" class="col-sm-2 col-form-label">Dominio:</label>
                <div class="col-sm-4">
                    <select class="form-select" id="dominio"></select>
                </div>
                <label for="lineaInvestigacion" class="col-sm-2 col-form-label">Línea de Investigación:</label>
                <div class="col-sm-4">
                    <select class="form-select" id="lineaInvestigacion"></select>
                </div>
            </div>
            <div class="mb-3 row">
                <label for="ciclo" class="col-sm-2 col-form-label">Ciclo:</label>
                <div class="col-sm-4">
                    <select class="form-select" id="ciclo"></select>
                </div>
                <label for="facilitador" class="col-sm-2 col-form-label">Facilitador:</label>
                <div class="col-sm-4">
                    <select class="form-select" id="facilitador"></select>
                </div>
            </div>
            <div class="mb-3 row">
                <label for="modalidad" class="col-sm-2 col-form-label">Modalidad:</label>
                <div class="col-sm-4">
                    <select class="form-select" id="modalidad"></select>
                </div>
                <label for="horario" class="col-sm-2 col-form-label">Horario:</label>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="horario">
                </div>
            </div>
            <div class="mb-3 row">
                <label for="grupo" class="col-sm-2 col-form-label">Grupo:</label>
                <div class="col-sm-4">
                    <select class="form-select" id="grupo"></select>
                </div>
                <label for="fechaInicio" class="col-sm-2 col-form-label">Fecha de inicio:</label>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="fechaInicio">
                </div>
            </div>
            <div class="mb-3 row">
                <label for="fechaFin" class="col-sm-2 col-form-label">Fecha de fin:</label>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="fechaFin">
                </div>
                <label for="horas" class="col-sm-2 col-form-label">Horas:</label>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="horas">
                </div>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <button type="button" class="btn btn-secondary">Cancelar</button>
            </div>
        </div>
    </form>
</div>