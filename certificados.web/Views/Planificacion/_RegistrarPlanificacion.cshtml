                     </div>
                 </div>
                 <div class="row">
                     <div class="col-md-6 mb-3">
                         <label for="fecha-inicio-planificacion" class="form-label">Fecha Inicio</label>
                         <input type="text" class="form-control" id="fecha-inicio-planificacion" name="fecha-inicio-planificacion" disabled>
                     </div>
                     <div class="col-md-6 mb-3">
                         <label for="fecha-fin-planificacion" class="form-label">Fecha Fin</label>
