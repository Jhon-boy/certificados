<div class="container mt-4">
    <!-- Tabs para la gestión de planificación -->
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link text-dark active" id="listar-planificacion-tab" data-bs-toggle="tab" href="#listar-planificacion" role="tab" aria-controls="listar-planificacion" aria-selected="true">Listar Planificaciones</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link text-dark" id="agregar-planificacion-tab" data-bs-toggle="tab" href="#agregar-planificacion" role="tab" aria-controls="agregar-planificacion" aria-selected="false">Agregar Planificación</a>
        </li>
@*         <li class="nav-item" role="presentation">
            <a class="nav-link text-dark" id="buscar-planificacion-tab" data-bs-toggle="tab" href="#buscar-planificacion" role="tab" aria-controls="buscar-planificacion" aria-selected="false">Buscar Planificación</a>
        </li> *@
    </ul>

    <div class="tab-content" id="myTabContent">
        <br />
        <!-- Contenido de la pestaña para listar planificaciones -->
        <div class="tab-pane fade show active m-1" id="listar-planificacion" role="tabpanel" aria-labelledby="listar-planificacion-tab">
            <table id="tabla-planificacion" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>ID Planificación</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Horas</th>
                        <th>Lugar</th>
                        <th>Periodo</th>
                        <th>Temática</th>
                        <th>Dominio</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Aquí se mostrarán los datos de las planificaciones -->
                </tbody>
            </table>
        </div>

        <!-- Contenido de la pestaña para agregar planificación -->
        <div class="tab-pane fade" id="agregar-planificacion" role="tabpanel" aria-labelledby="agregar-planificacion-tab">
            <!-- Formulario de Agregar Planificación -->
            <form id="form-planificacion" class="border border-2 p-4 rounded" onsubmit="return handleAgregarPlanificacion(event)">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="tipo-evento" class="form-label">Tipo de Evento</label>
                        <select class="form-select" id="tipo-evento" name="tipo-evento" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="tematica" class="form-label">Temática</label>
                        <input type="text" class="form-control" id="tematica" name="tematica" placeholder="Ingrese la temática" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="dominio" class="form-label">Dominio</label>
                        <select class="form-select" id="dominio" name="dominio" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="linea-investigacion" class="form-label">Línea de Investigación</label>
                        <select class="form-select" id="linea-investigacion" name="linea-investigacion" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="ciclo" class="form-label">Ciclo</label>
                        <select class="form-select" id="ciclo" name="ciclo" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="facilitador" class="form-label">Facilitador</label>
                        <select class="form-select" id="facilitador" name="facilitador" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="modalidad" class="form-label">Modalidad</label>
                        <select class="form-select" id="modalidad" name="modalidad" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="horario" class="form-label">Horario</label>
                        <input type="text" class="form-control" id="horario" name="horario" placeholder="Ingrese el horario" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="grupo" class="form-label">Grupo</label>
                        <select class="form-select" id="grupo" name="grupo" required>
                            <option value="">Seleccione...</option>
                            <!-- Opciones dinámicas -->
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="fecha-inicio" class="form-label">Fecha Inicio</label>
                        <input type="date" class="form-control" id="fecha-inicio" name="fecha-inicio" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="fecha-fin" class="form-label">Fecha Fin</label>
                        <input type="date" class="form-control" id="fecha-fin" name="fecha-fin" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="horas" class="form-label">Horas</label>
                        <input type="number" class="form-control" id="horas" name="horas" placeholder="Ingrese las horas" required>
                    </div>
                </div>
                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary mx-2">Guardar</button>
                    <button type="reset" class="btn btn-secondary mx-2">Limpiar</button>
                </div>
            </form>
        </div>

