                     </div>
                 </div>
             </form>
         </div> *@
    </div>

    <!-- Modal para editar planificación -->
    <div class="modal fade" id="modal-editar-planificacion" tabindex="-1" aria-labelledby="modalEditarPlanificacionLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEditarPlanificacionLabel">Editar Planificación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="form-editar-planificacion" onsubmit="return handleEditarPlanificacion(event)">
                        <div class="mb-3">
                            <label for="editar-id-planificacion" class="form-label">ID Planificación</label>
                            <input type="text" class="form-control" id="editar-id-planificacion" name="editar-id-planificacion" readonly>
                        </div>
                        <div class="mb-3">
                            <label for="editar-nombre-planificacion" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="editar-nombre-planificacion" name="editar-nombre-planificacion" required>
                        </div>
                        <div class="mb-3">
                            <label for="editar-responsable-planificacion" class="form-label">Responsable</label>
                            <input type="text" class="form-control" id="editar-responsable-planificacion" name="editar-responsable-planificacion" required>
                        </div>
                        <div class="mb-3">
                            <label for="editar-fecha-inicio-planificacion" class="form-label">Fecha Inicio</label>
                            <input type="date" class="form-control" id="editar-fecha-inicio-planificacion" name="editar-fecha-inicio-planificacion" required>
                        </div>
                        <div class="mb-3">
                            <label for="editar-fecha-fin-planificacion" class="form-label">Fecha Fin</label>
                            <input type="date" class="form-control" id="editar-fecha-fin-planificacion" name="editar-fecha-fin-planificacion" required>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary mx-2">Guardar Cambios</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
