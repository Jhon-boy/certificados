<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consulta de Eventos</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
</head>
<body>
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Consulta de Eventos</h3>
            <button id="btnAgregar" class="btn btn-primary">Agregar Evento</button>
        </div>

        <div class="table-responsive">
            <table id="tablaEventos" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Temática</th>
                        <th>Facilitador</th>
                        <th>Modalidad</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Total Horas</th>
                        <th>Grupo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Metodología de la Investigación</td>
                        <td>Héctor Mero</td>
                        <td>Virtual</td>
                        <td>2024-09-10</td>
                        <td>2025-10-12</td>
                        <td>50</td>
                        <td>SOFT-NO-10-3</td>
                        <td>
                            <button class="btn btn-sm btn-warning btnEditar">Editar</button>
                            <button class="btn btn-sm btn-danger btnEliminar">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/planificacion.js"></script>

</body>
</html>
