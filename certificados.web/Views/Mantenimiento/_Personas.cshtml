<div class="modal fade" id="modal-editar-persona" tabindex="-1" aria-labelledby="modal-editar-persona-label" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-editar-persona-label">Agregar Nueva Persona</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-6">
                        <label for="persona-cedula" class="form-label">Cédula</label>
                        <input type="text" class="form-control" id="persona-cedula" placeholder="Ingresa la cédula">
                    </div>
                    <div class="col-6">
                        <label for="persona-nombres" class="form-label">Nombres</label>
                        <input type="text" class="form-control" id="persona-nombres" placeholder="Ingresa los nombres">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="persona-apellidos" class="form-label">Apellidos</label>
                        <input type="text" class="form-control" id="persona-apellidos" placeholder="Ingresa los apellidos">
                    </div>
                    <div class="col-6">
                        <label for="persona-edad" class="form-label">Edad</label>
                        <input type="number" class="form-control" id="persona-edad" placeholder="Ingresa la edad">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="persona-genero" class="form-label">Género</label>
                        <select class="form-control" id="persona-genero">
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                            <option value="O">Otro</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label for="persona-email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="persona-email" placeholder="Ingresa el correo electrónico">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="persona-clave" class="form-label">Contraseña</label>
                        <input type="password" class="form-control" id="persona-clave" placeholder="Ingresa la contraseña">
                    </div>
                    <div class="col-6">
                        <label for="persona-rol" class="form-label">Rol</label>
                        <select class="form-control" id="persona-rol">
                            <option value="1">Administrador</option>
                            <option value="2">Usuario</option>
                            <option value="3">Invitado</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btn-guardar-cambios">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <h2>Lista de Personas</h2>
    <button class="btn btn-success mb-3" onclick="agregarPersona('Persona')">Agregar Nueva Persona</button>

    <table id="tabla-persona" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Edad</th>
                <th>Género</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <!-- Aquí se cargarán los registros de personas -->
        </tbody>
    </table>
</div>
