@section Scripts {
    <script src="~/js/roles.js"></script>
}

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active text-dark" id="home-tab" data-bs-toggle="tab" data-bs-target="#nav-home" type="button" role="tab" aria-controls="nav-home" aria-selected="true">Ver Roles</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link text-dark" id="profile-tab" data-bs-toggle="tab" data-bs-target="#nav-profile" type="button" role="tab" aria-controls="nav-profile" aria-selected="false">Agregar Rol</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link text-dark" id="contact-tab" data-bs-toggle="tab" data-bs-target="#nav-contact" type="button" role="tab" aria-controls="nav-contact" aria-selected="false">Buscar</button>
    </li>
</ul>

<div class="tab-content" id="nav-tabContent">
    <!-- Tab Ver Roles -->
    <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
        <div class="container mt-4">
            <h2>Lista de Roles</h2>
            <table id="tabla-rol" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Observación</th>
                        <th>Estado</th>
                        <th>Usuario Ingreso</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Aquí se cargarán los registros de roles -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab Agregar Rol -->
    <div class="tab-pane fade" id="nav-profile" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
        <div class="card mx-5 my-5">
            <div class="card-header">Registro de un Rol</div>
            <form class="row g-3 needs-validation px-3" novalidate>
                <div class="col-md-6 position-relative">
                    <label for="rolNombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="rolNombre" required>
                    <div class="invalid-tooltip">Escribe el nombre del Rol</div>
                </div>
                <div class="col-md-3 position-relative">
                    <label for="rolEstado" class="form-label">Estado</label>
                    <select class="form-select" id="rolEstado" required>
                        <option selected disabled value="">Selecciona un estado</option>
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                    <div class="invalid-tooltip">Selecciona un estado</div>
                </div>
                <div class="col-md-3 position-relative">
                    <label for="usuarioIngreso" class="form-label">Usuario Ingreso</label>
                    <input type="text" class="form-control" id="usuarioIngreso" disabled>
                </div>
                <div class="mb-3">
                    <label for="rolDescripcion" class="form-label">Descripción</label>
                    <textarea class="form-control" id="rolDescripcion" placeholder="Descripción obligatoria" required></textarea>
                    <div class="invalid-feedback">Escribe la descripción</div>
                </div>
            </form>
            <div class="col-12 d-flex justify-content-center">
                <button class="btn btn-primary me-3" onclick="agregarRol(event)">Guardar</button>
                <button class="btn btn-danger" onclick="limpiarRol()">Cancelar</button>
            </div>
        </div>
    </div>

     
    <div class="tab-pane fade" id="nav-contact" role="tabpanel" aria-labelledby="contact-tab" tabindex="0">
        <div class="container mt-4">
            <h2>Buscar Roles</h2>
            <div class="row mb-3">
                <div class="col-6">
                    <label for="buscar-rol" class="form-label">Buscar por nombre de rol</label>
                    <input type="text" class="form-control" id="buscar-rol" placeholder="Ingresa el nombre del rol">
                </div>
            </div>
            <button class="btn btn-primary">Buscar</button>
        </div>
    </div>
</div>

<script src="~/js/roles.js" asp-append-version="true"></script>
