<div class="container mt-4">
    <h2>Lista de Docentes</h2>
    <button class="btn btn-success mb-3" onclick="agregarDocente('Docente')">Agregar Nuevo Docente</button>

    <table id="tabla-docente" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Código Docente</th>
                <th>Cédula</th>
                <th>Título</th>
                <th>Facultad</th>
                <th>Carrera</th>
                <th>Estado</th>
                <th>Usuario Ingreso</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <!-- Aquí se cargarán los registros de docentes -->
        </tbody>
    </table>
</div>

<!-- Modal para agregar/editar docente -->
<div class="modal fade" id="modal-editar-docente" tabindex="-1" aria-labelledby="modal-editar-docente-label" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-editar-docente-label">Agregar Nuevo Docente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Formulario para el docente -->
                <div class="row mb-3">
                    <div class="col-6">
                        <label for="docente-codigo" class="form-label">Código Docente</label>
                        <input type="text" class="form-control" id="docente-codigo" placeholder="Ingresa el código docente">
                    </div>
                    <div class="col-6">
                        <label for="docente-cedula" class="form-label">Cédula</label>
                        <input type="text" class="form-control" id="docente-cedula" placeholder="Ingresa la cédula">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="docente-titulo" class="form-label">Título</label>
                        <input type="text" class="form-control" id="docente-titulo" placeholder="Ingresa el título">
                    </div>
                    <div class="col-6">
                        <label for="docente-facultad" class="form-label">Facultad</label>
                        <input type="text" class="form-control" id="docente-facultad" placeholder="Ingresa la facultad">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="docente-carrera" class="form-label">Carrera</label>
                        <input type="text" class="form-control" id="docente-carrera" placeholder="Ingresa la carrera">
                    </div>
                    <div class="col-6">
                        <label for="docente-estado" class="form-label">Estado</label>
                        <select class="form-control" id="docente-estado">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="docente-usuarioingreso" class="form-label">Usuario Ingreso</label>
                        <input type="text" class="form-control" id="docente-usuarioingreso" placeholder="Usuario ingreso">
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btn-guardar-cambios">Guardar</button>
            </div>
        </div>
    </div>
</div>
