<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet"/>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.11.5/js/dataTables.bootstrap5.min.js"></script>
  </head>
  <body>
    <div class="container mt-5">
      <h3 class="text-center">Lista de Grupos</h3>
      <button class="btn btn-success mb-3" onclick="agregarRegistro()">Agregar Grupo</button>
      <table id="tabla-grupos" class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>GRUPO</th>
            <th class="text-end">ACCIONES</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Grupo A</td>
            <td class="text-end">
              <button class="btn btn-primary btn-sm" onclick="editarRegistro('Grupo A')">Editar</button>
              <button class="btn btn-danger btn-sm" onclick="eliminarRegistro('Grupo A')">Eliminar</button>
            </td>
          </tr>
          <tr>
            <td>Grupo B</td>
            <td class="text-end">
              <button class="btn btn-primary btn-sm" onclick="editarRegistro('Grupo B')">Editar</button>
              <button class="btn btn-danger btn-sm" onclick="eliminarRegistro('Grupo B')">Eliminar</button>
            </td>
          </tr>
          <tr>
            <td>Grupo C</td>
            <td class="text-end">
              <button class="btn btn-primary btn-sm" onclick="editarRegistro('Grupo C')">Editar</button>
              <button class="btn btn-danger btn-sm" onclick="eliminarRegistro('Grupo C')">Eliminar</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="modal fade" id="modal-editar" tabindex="-1" aria-labelledby="modal-editar-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modal-editar-label">Editar Grupo</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <form id="form-editar">
              <div class="mb-3">
                <label for="grupo-nombre" class="form-label">Nombre del Grupo</label>
                <input type="text" class="form-control" id="grupo-nombre" required />
              </div>
              <div class="mb-3">
                <label for="grupo-descripcion" class="form-label">Descripción</label>
                <textarea class="form-control" id="grupo-descripcion" rows="3"></textarea>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            <button type="button" class="btn btn-primary" onclick="guardarCambios()">Guardar Cambios</button>
          </div>
        </div>
      </div>
    </div>
    <script>
      $(document).ready(function () {
        $('#tabla-grupos').DataTable({
          language: {
            sProcessing: 'Procesando...',
            sLengthMenu: 'Mostrar _MENU_ registros',
            sZeroRecords: 'No se encontraron resultados',
            sEmptyTable: 'Ningún dato disponible en esta tabla',
            sInfo: 'Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros',
            sInfoEmpty: 'Mostrando registros del 0 al 0 de un total de 0 registros',
            sInfoFiltered: '(filtrado de un total de _MAX_ registros)',
            sSearch: 'Buscar:',
            sUrl: '',
            sInfoThousands: ',',
            sLoadingRecords: 'Cargando...',
            oPaginate: {
              sFirst: 'Primero',
              sPrevious: 'Anterior',
              sNext: 'Siguiente',
              sLast: 'Último',
            },
            oAria: {
              sSortAscending: ': activar para ordenar la columna de manera ascendente',
              sSortDescending: ': activar para ordenar la columna de manera descendente',
            },
          },
        });
      });

      function editarRegistro(grupo) {
        $('#grupo-nombre').val(grupo);
        $('#grupo-descripcion').val('Descripción de ' + grupo);
        $('#modal-editar').modal('show');
        $('#modal-editar-label').text('Editar Grupo');
      }

      function agregarRegistro() {
        $('#grupo-nombre').val('');
        $('#grupo-descripcion').val('');
        $('#modal-editar-label').text('Agregar Nuevo Grupo');
        $('#modal-editar').modal('show');
      }

      function guardarCambios() {
        var nombreGrupo = $('#grupo-nombre').val();
        var descripcionGrupo = $('#grupo-descripcion').val();

        if (!nombreGrupo) {
          alert('El nombre del grupo es obligatorio.');
          return;
        }

        if ($('#modal-editar-label').text() === 'Agregar Nuevo Grupo') {
          $('#tabla-grupos')
            .DataTable()
            .row.add([
              nombreGrupo,
              '<button class="btn btn-primary btn-sm" onclick="editarRegistro(\'' +
                nombreGrupo +
                '\')">Editar</button>' +
                '<button class="btn btn-danger btn-sm" onclick="eliminarRegistro(\'' +
                nombreGrupo +
                '\')">Eliminar</button>',
            ])
            .draw();

          alert('Nuevo grupo agregado: ' + nombreGrupo);
        } else {
          alert('Cambios guardados para: ' + nombreGrupo + '\nDescripción: ' + descripcionGrupo);
        }

        $('#modal-editar').modal('hide');
      }

      function eliminarRegistro(grupo) {
        if (confirm('¿Estás seguro de que deseas eliminar el grupo: ' + grupo + '?')) {
          var table = $('#tabla-grupos').DataTable();
          table.rows().every(function () {
            var data = this.data();
            if (data[0] === grupo) {
              this.remove();
            }
          });
          table.draw();
          alert('Grupo eliminado: ' + grupo);
        }
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
