<html>
<head>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <!-- Font Awesome 5 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

    <!-- Latest DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>
        .table-container {
            margin-top: 20px;
        }

        .btn-agregar {
            background-color: #007bff;
            color: white;
        }

            .btn-agregar:hover {
                background-color: #0056b3;
            }

        .table th, .table td {
            vertical-align: middle;
        }

        .action-icons i {
            font-size: 1.5rem;
            margin-right: 10px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <input type="text" id="customSearchBox" class="form-control" placeholder="Buscar">
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-agregar" data-bs-toggle="modal" data-bs-target="#addEditModal" onclick="openAddModal()">AGREGAR</button>
            </div>
        </div>
        <div class="row table-container">
            <div class="col-12">
                <table id="example" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Grupo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>SOFT-MA-10-1</td>
                            <td class="text-center action-icons">
                                <i class="fas fa-edit text-primary edit-btn" onclick="openEditModal(this)"></i>
                                <i class="fas fa-trash-alt text-dark delete-btn" onclick="openDeleteModal(this)"></i>
                            </td>
                        </tr>
                        <tr>
                            <td>SOFT-NO-10-2</td>
                            <td class="text-center action-icons">
                                <i class="fas fa-edit text-primary edit-btn" onclick="openEditModal(this)"></i>
                                <i class="fas fa-trash-alt text-dark delete-btn" onclick="openDeleteModal(this)"></i>
                            </td>
                        </tr>
                        <tr>
                            <td>SOFT-VE-10-3</td>
                            <td class="text-center action-icons">
                                <i class="fas fa-edit text-primary edit-btn" onclick="openEditModal(this)"></i>
                                <i class="fas fa-trash-alt text-dark delete-btn" onclick="openDeleteModal(this)"></i>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="addEditModal" tabindex="-1" aria-labelledby="addEditModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addEditModalLabel">Agregar/Editar Registro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addEditForm">
                        <div class="mb-3">
                            <label for="grupo" class="form-label">Grupo</label>
                            <input type="text" class="form-control" id="grupo" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que deseas eliminar este registro?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest jQuery, DataTables and Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js" integrity="sha384-oBqDVmMz4fnFO9gybBogGzOgQpeKBmBiFjC6fFzO9e6Fz6p6D6V5D5p6D5p6D5p6" crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            var table = $('#example').DataTable({
                paging: false,
                info: false,
                searching: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Buscar..."
                }
            });

            $('#customSearchBox').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Hide default DataTables search box
            $('#example_filter').hide();

            var editRow = null;
            var deleteRow = null;

            // Handle form submission
            $('#addEditForm').on('submit', function (e) {
                e.preventDefault();
                var grupo = $('#grupo').val();

                if (editRow) {
                    table.row(editRow).data([
                        grupo,
                        '<i class="fas fa-edit text-primary edit-btn" onclick="openEditModal(this)"></i><i class="fas fa-trash-alt text-dark delete-btn" onclick="openDeleteModal(this)"></i>'
                    ]).draw(false);
                    editRow = null;
                } else {
                    table.row.add([
                        grupo,
                        '<i class="fas fa-edit text-primary edit-btn" onclick="openEditModal(this)"></i><i class="fas fa-trash-alt text-dark delete-btn" onclick="openDeleteModal(this)"></i>'
                    ]).draw(false);
                }

                $('#addEditModal').modal('hide');
                $('#addEditForm')[0].reset();
            });

            // Handle delete button click
            $('#confirmDeleteBtn').on('click', function () {
                if (deleteRow) {
                    table.row(deleteRow).remove().draw();
                    deleteRow = null;
                }
                $('#deleteModal').modal('hide');
            });

            // Reset modal on close
            $('#addEditModal').on('hidden.bs.modal', function () {
                $('#addEditModalLabel').text('Agregar Registro');
                $('#addEditForm')[0].reset();
                editRow = null;
            });
        });

        function openAddModal() {
            $('#addEditModalLabel').text('Agregar Registro');
            $('#addEditForm')[0].reset();
            editRow = null;
        }

        function openEditModal(element) {
            var table = $('#example').DataTable();
            editRow = table.row($(element).parents('tr'));
            var data = editRow.data();
            $('#grupo').val(data[0]);
            $('#addEditModalLabel').text('Editar Registro');
            $('#addEditModal').modal('show');
        }

        function openDeleteModal(element) {
            var table = $('#example').DataTable();
            deleteRow = table.row($(element).parents('tr'));
            $('#deleteModal').modal('show');
        }
    </script>
</body>
</html>
