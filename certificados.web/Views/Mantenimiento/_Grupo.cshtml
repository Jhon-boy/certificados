<div class="container mt-5">
    <h3 class="text-center">Lista de Grupos</h3>
    <button class="btn btn-success mb-3" onclick="agregarGrupo()">Agregar Grupo</button>
    <table id="tabla-grupos" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>GRUPO</th>
                <th class="text-end">ACCIONES</th>
            </tr>
        </thead>
        <tbody id="tabla-grupos-body">
           
        </tbody>
    </table>
</div>

<div class="modal fade" id="modal-editar" tabindex="-1" aria-labelledby="modal-editar-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-editar-label">Editar Grupo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="form-editar">
                    <div class="mb-3">
                        <label for="grupo-nombre" class="form-label">Nombre del Grupo</label>
                        <input type="text" class="form-control" id="grupo-nombre" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="guardarCambios()">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>